# Application Configuration
APP_NAME=ClaudeCode Lab Agent
APP_ENV=development
DEBUG=true

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Option A: AWS Bedrock (Strands SDK) ──────────────────────────────────────
# Fill these in to use Amazon Bedrock. Takes priority over the Anthropic key.
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...          # only needed for temporary credentials
# AWS_DEFAULT_REGION=eu-west-1
# CLAUDE_MODEL_ID=eu.anthropic.claude-sonnet-4-5-20250929-v1:0

# ── Option B: Direct Anthropic API (default) ──────────────────────────────────
# Used automatically when AWS credentials above are not set.
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL_ID=claude-sonnet-4-6
